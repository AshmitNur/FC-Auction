PORT=4000

# Supabase project URL for project_ref unjkumzwxqkdhytwjybj:
SUPABASE_URL=https://unjkumzwxqkdhytwjybj.supabase.co

# Preferred for this LAN server: Supabase pooler connection.
# The direct db.* host is IPv6-only for this project on some networks.
DATABASE_URL=postgresql://postgres.unjkumzwxqkdhytwjybj:replace-with-your-db-password@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# Required on Vercel to keep /api/state reads off direct Postgres connections.
# This stays server-side only; never expose it with a VITE_ or NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional escape hatch for debugging. Leave false/unset in production.
FORCE_POSTGRES_READS=false

SUPABASE_STATE_TABLE=fc26_app_state
SUPABASE_PLAYER_TABLE=fc26_players
SUPABASE_STATE_KEY=default
